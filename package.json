{
  "name": "reto-02-galvis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "demo": "npm run build && node dist/demo.js",
    "dev": "npm run build && node --env-file=.env dist/src/server.js",
    "start": "node dist/src/server.js",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "typescript": "^5.8.3"
  }
}
